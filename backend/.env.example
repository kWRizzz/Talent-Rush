# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your_jwt_secret_key_here

# Database
DB_URL=mongodb://127.0.0.1:27017/talent_rush
# For MongoDB Atlas:
# DB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/talent_rush?retryWrites=true&w=majority

# Client Application URL (CORS)
CLIENT_URL=http://localhost:5173

# Optional: Background Job / Inngest Configuration
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Optional: Stream Video / Clerk integrations
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
